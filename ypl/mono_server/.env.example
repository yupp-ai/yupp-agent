# =========================================================================
# Yupp Agent Platform — One-Box Deployment Configuration Example
# =========================================================================
# Copy this file to .env and fill in your values, OR run:
#
#   python -m ypl.mono_server.setup
#
# The setup wizard reads this file as a template, generates .env
# interactively with auto-generated secrets, runs database migrations,
# and seeds initial roles and users.
# =========================================================================

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# Deployment environment: local | selfhosted | staging | production
#   - local:      dev laptop / CI. No GCP calls.
#   - selfhosted: AHS monolith on a single VM (GCE/other). Same GCP-free path
#                 as local, but keeps prod-style signature checks and HTTPS.
#   - staging / production: yupp-llms GKE deployment with GCP Secret Manager.
ENVIRONMENT=selfhosted

# Which database get_async_session() uses by default.
# One-box mode always uses agentdb (the agent-specific database).
DEFAULT_DB=agentdb

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# JSON-encoded connection parameters for the agent database.
# Format: {"user":"...", "password":"...", "host":"localhost:5432", "database":"yadb"}
# The setup wizard populates this automatically.
#
# Two-role setup (recommended): use be_app_user for runtime (below) and set
# POSTGRES_CONNECTION_AGENTDB_ADMIN to schema_manager creds (below) for
# Alembic migrations. The install script's deploy/bare-metal/install.sh
# creates both roles and writes their passwords to /opt/yupp-agent/.pg-creds.
POSTGRES_CONNECTION_AGENTDB={"user":"be_app_user","password":"changethis","host":"localhost:5432","database":"yadb"}

# DDL / Alembic connection. Used for `alembic upgrade head`, not for runtime.
# Leave empty to fall back to POSTGRES_CONNECTION_AGENTDB (single-role mode).
# POSTGRES_CONNECTION_AGENTDB_ADMIN={"user":"schema_manager","password":"changethis","host":"localhost:5432","database":"yadb"}

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Redis URL for session state, caching, and pub/sub.
# Use database index 1 (index 0 is reserved for Celery-compatible consumers).
REDIS_URL=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Security — API Keys & Secrets
# ---------------------------------------------------------------------------
# Random 32-byte secret key — auto-generated by setup.py.
# Used for signing sessions and internal tokens. Rotate by generating a new value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# AHS API key — protects all /ahs/* endpoints.
# Every caller of the AHS API must supply this in the X-API-Key header.
# Auto-generated by setup.py.
X_API_KEY=

# Shared API key between AHS and the Slack/GitHub gateways.
# Used for mutual authentication on /gw/* callback routes.
# Auto-generated by setup.py.
AGENT_HARNESS_SERVICE_API_KEY=

# ---------------------------------------------------------------------------
# Service URLs
# ---------------------------------------------------------------------------
# Base URL where this server is reachable from within the machine (or LAN).
# Used by gateways to call back to AHS.
AGENT_HARNESS_SERVICE_BASE_URL=http://localhost:8090

# Public-facing base URL — set to your Cloudflare Tunnel URL for external access.
# Falls back to AGENT_HARNESS_SERVICE_BASE_URL if not set.
GATEWAY_BASE_URL=http://localhost:8090

# MCP server public base URL — used in token emails and OAuth redirect URIs.
MCP_SERVER_BASE_URL=http://localhost:8090

# Lit (Streamlit console) public base URL — used for session links in Slack
# messages, PR descriptions, CLI output, etc. Leave empty to omit Lit links.
# Example: https://lit.yourdomain.com
AHS_LIT_BASE_URL=

# ---------------------------------------------------------------------------
# Host-Based Path Guard (optional — for subdomain isolation)
# ---------------------------------------------------------------------------
# When the mono-server is fronted by Cloudflare Tunnel (or any reverse proxy)
# on multiple subdomains, HOST_PATH_GUARD restricts which path prefixes are
# reachable through each subdomain. Hosts NOT listed here pass through
# untouched — localhost and direct LAN access still see every route.
#
# JSON-encoded map: { "hostname": ["/allowed/prefix", ...] }.
# An empty list blocks every path on that host. Requests whose path does not
# start with an allowed prefix return HTTP 404.
#
# Example: only expose /mcp (and /health for probes) on mcp.<domain>:
# HOST_PATH_GUARD={"mcp.agcouch.com":["/mcp","/health"]}
HOST_PATH_GUARD=

# ---------------------------------------------------------------------------
# MCP Authentication
# ---------------------------------------------------------------------------
# Authentication mode for the MCP server:
#   DEV_TOKEN  — developer tokens (yupp_dev_*), simpler, recommended for one-box
#   OAUTH      — Google OAuth flow (requires CLIENT_ID / CLIENT_SECRET below)
MCP_SERVER_MODE=DEV_TOKEN

# SECURITY: comma-separated admin emails allowed to create agent sessions via
# service tokens.  These bypass dev-token auth for server-to-server calls made
# by the harness.  Keep this list minimal — treat it like a root-access list.
AHS_SERVICE_TOKEN_EMAILS=

# --- OAuth mode (only needed when MCP_SERVER_MODE=OAUTH) ---
MCP_OAUTH_GOOGLE_CLIENT_ID=
MCP_OAUTH_GOOGLE_CLIENT_SECRET=

# Random 32-byte key for JWT signing in OAuth mode.
# Auto-generated by setup.py (base64url-encoded).
MCP_OAUTH_JWT_SIGNING_KEY=

# Random 32-byte key for storage encryption in OAuth mode.
# Auto-generated by setup.py (base64url-encoded).
MCP_OAUTH_STORAGE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Gateway Toggles
# ---------------------------------------------------------------------------
# Enable the Slack Agent Gateway — mounts at /gw/slack.
# Requires SLACK_AGENT_GATEWAY_* credentials below when enabled.
GATEWAY_SLACK_ENABLED=true

# Enable the GitHub webhook gateway — mounts at /gw/github.
# Disabled by default; enable only if you need automated code-review webhooks.
GATEWAY_GITHUB_ENABLED=false

# ---------------------------------------------------------------------------
# Slack Agent Gateway (only needed when GATEWAY_SLACK_ENABLED=true)
# ---------------------------------------------------------------------------
# The set of active agents is driven by the ``slack_agents`` DB table — insert
# rows there (via BotFather's OAuth flow in production, or direct SQL insert
# for self-hosted setups) rather than maintaining a parallel env list.

# Fernet encryption key for Slack OAuth tokens (base64url-encoded 32-byte key).
# Auto-generated by setup.py.
SLACK_AGENT_GW_ENCRYPTION_KEY=

# Per-agent Slack app credentials. One BOT_TOKEN + SIGNING_SECRET pair per
# bot_name row in the slack_agents table. (APP_ID lives in the DB row.)
# Obtain from https://api.slack.com/apps after creating your Slack app.

# Example (one block per row in the slack_agents table; key = uppercased
# bot_name, dashes → underscores):
# SLACK_AGENT_GATEWAY_EXAMPLEBOT_BOT_TOKEN=xoxb-...
# SLACK_AGENT_GATEWAY_EXAMPLEBOT_SIGNING_SECRET=...

# ---------------------------------------------------------------------------
# Blob storage (artifact content + attachments)
# ---------------------------------------------------------------------------
# Engine: "local" (default — writes under BLOB_STORE_LOCAL_DIR) or "gcs".
BLOB_STORE_ENGINE=local
# Local storage root (used when BLOB_STORE_ENGINE=local).
BLOB_STORE_LOCAL_DIR=/data/ahs/artifacts
# Optional public base URL for artifact links (used when BLOB_STORE_ENGINE=local).
# Leave empty to skip URL generation for local blobs.
BLOB_STORE_LOCAL_BASE_URL=

# Public base URL of the artifact viewer (apps/artifact-viewer/). Used by
# create_artifact() to populate agent_artifacts.url so every new artifact
# gets a human-readable shareable link (e.g.
# https://artifacts.agcouch.com/artifacts/<uuid>). No trailing slash.
# Leave empty to fall back to the raw /ahs/artifacts/<uuid> path.
VIEWER_BASE_URL=https://artifacts.agcouch.com

# ---------------------------------------------------------------------------
# GCS / Cloud Storage (optional — required only when BLOB_STORE_ENGINE=gcs)
# ---------------------------------------------------------------------------
# GCS bucket for artifact content (used when BLOB_STORE_ENGINE=gcs).
# Leave empty to disable GCS-backed artifacts.
GCS_BUCKET_NAME=

# ---------------------------------------------------------------------------
# LLM Provider API Keys (add keys for the providers you use)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Linear Integration (optional)
# ---------------------------------------------------------------------------
LINEAR_API_KEY=

# ---------------------------------------------------------------------------
# GitHub Integration (optional — for code review webhooks)
# ---------------------------------------------------------------------------
READ_COMMIT_HISTORY_GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Sandbox (bwrap — Linux only)
# ---------------------------------------------------------------------------
# bwrap provides filesystem isolation for agent-executed shell commands.
# Set to false on macOS or Docker without --privileged.
# SANDBOX_ENABLED=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Disable Google Cloud Logging for local/VM deployments.
# Logs go to stdout (picked up by systemd journal or Docker logging driver).
USE_GOOGLE_CLOUD_LOGGING=false

# Disable GCP metrics write (no-op in local mode anyway).
DISABLE_WRITE_GOOGLE_CLOUD_METRICS=true
