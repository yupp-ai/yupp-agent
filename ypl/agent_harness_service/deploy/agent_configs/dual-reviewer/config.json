{
  "display_name": "Dual Reviewer",
  "description": "Review coordinator \u2014 spawns two reviewers, synthesizes, then fixes.",
  "default_repo": "yupp-agent",
  "max_turns": 200,
  "max_budget_usd": 10.0,
  "has_mcp": true,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "executor_config": {
    "type": "harnessed"
  },
  "tool_permissions": {
    "*": "deny",
    "@readonly": "allow",
    "bash": "allow",
    "route_model": "allow",
    "new_task": "allow"
  },
  "allowed_subagents": [
    "reviewer"
  ],
  "timeout_s": 36000
}
