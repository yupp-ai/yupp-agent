{
  "display_name": "Reviewer (GLM)",
  "description": "Code reviewer using ZhipuAI GLM-5 on raw executor.",
  "default_repo": "yupp-agent",
  "max_turns": 100,
  "max_budget_usd": 1.0,
  "has_mcp": false,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "executor_config": {
    "type": "raw",
    "model": "zai/glm-5"
  },
  "tool_permissions": {
    "*": "allow"
  },
  "allowed_subagents": [],
  "streaming": false,
  "timeout_s": 36000
}
