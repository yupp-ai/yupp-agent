{
  "display_name": "Master Reviewer",
  "description": "Review coordinator — orchestrates sub-reviewers on first round, self-reviews on subsequent rounds.",
  "default_repo": "yupp-agent",
  "max_turns": 200,
  "max_budget_usd": 15.0,
  "has_mcp": true,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "executor_config": {
    "type": "harnessed"
  },
  "tool_permissions": {
    "*": "deny",
    "@readonly": "allow",
    "bash": "allow",
    "route_model": "allow",
    "new_task": "allow",
    "send_agent_message": "allow"
  },
  "allowed_subagents": [
    "reviewer-claude",
    "reviewer-codex"
  ],
  "allowed_to_message": [
    "*"
  ],
  "timeout_s": 36000
}
