{
  "display_name": "Reviewer (MiniMax)",
  "description": "Code reviewer using MiniMax M2.5 on raw executor with reasoning.",
  "default_repo": "yupp-agent",
  "max_turns": 100,
  "max_budget_usd": 1.0,
  "has_mcp": false,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "executor_config": {
    "type": "raw",
    "model": "minimax/MiniMax-M2.5"
  },
  "tool_permissions": {
    "*": "allow"
  },
  "allowed_subagents": [],
  "streaming": false,
  "timeout_s": 36000,
  "model_parameters": {
    "reasoning_split": true
  }
}
