{
  "display_name": "SRE",
  "description": "SRE agent — reliability, incident response, and infrastructure debugging.",
  "default_repo": "yupp-agent",
  "max_turns": 200,
  "max_budget_usd": 3.0,
  "has_mcp": true,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "executor_config": {
    "type": "harnessed"
  },
  "tool_permissions": {
    "*": "allow"
  },
  "allowed_subagents": [],
  "timeout_s": 36000,
  "required_tools": [
    "mcp__yuppster-mcp-server__query_agentdb",
    "mcp__yuppster-mcp-server__search_gcp_logs",
    "mcp__yuppster-mcp-server__search_agent_memory",
    "mcp__yuppster-mcp-server__get_agent_memory",
    "mcp__yuppster-mcp-server__store_agent_memory",
    "mcp__yuppster-mcp-server__create_yuppaste",
    "mcp__yuppster-mcp-server__add_artifact",
    "mcp__yuppster-mcp-server__search_slack",
    "mcp__yuppster-mcp-server__read_slack_thread",
    "mcp__harness__send_slack_message"
  ]
}
