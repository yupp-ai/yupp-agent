{
  "display_name": "SRE",
  "description": "SRE agent \u2014 reliability, incident response, and infrastructure debugging.",
  "default_repo": "yupp-agent",
  "max_turns": 200,
  "max_budget_usd": 3.0,
  "has_mcp": true,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "executor_config": {
    "type": "harnessed"
  },
  "tool_permissions": {
    "*": "allow"
  },
  "allowed_subagents": [],
  "timeout_s": 36000,
  "required_tools": [
    "mcp__harness__query_agentdb",
    "mcp__harness__search_gcp_logs",
    "mcp__harness__search_memory",
    "mcp__harness__load_memory",
    "mcp__harness__save_memory",
    "mcp__harness__add_artifact",
    "mcp__harness__search_slack",
    "mcp__harness__read_slack_thread",
    "mcp__harness__send_slack_message"
  ],
  "external_mcps": [
    "arti"
  ]
}
