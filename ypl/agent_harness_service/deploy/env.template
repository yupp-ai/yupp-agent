# Agent Harness Service — Environment Variables
#
# Copy to /data/ahs/.env and fill in values.
# This file is loaded by systemd (EnvironmentFile) — do NOT "source" it.
#
# The service imports ypl.backend.config.Settings, which reads standard
# backend env vars (POSTGRES_*, ENVIRONMENT, etc.) from the environment.
# Start with a trimmed-down copy of the main backend .env, then add the
# AHS-specific vars below.
#
# Minimum backend vars you MUST include (copy from the main .env):
#   ENVIRONMENT, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST,
#   POSTGRES_HOST_NON_POOLING, POSTGRES_DATABASE,
#   POSTGRES_USER_READ_REPLICA, POSTGRES_PASSWORD_READ_REPLICA,
#   POSTGRES_HOST_READ_REPLICA, POSTGRES_HOST_NON_POOLING_READ_REPLICA,
#   POSTGRES_DATABASE_READ_REPLICA

# ===========================================================================
#  REQUIRED — AHS-specific
# ===========================================================================

# API key shared between the Slack gateway and AHS (SAG → AHS auth)
AGENT_HARNESS_SERVICE_API_KEY=changeme

# General backend API key (AHS → SAG callback auth)
X_API_KEY=changeme

# Anthropic API key used by the Claude Code CLI subprocess
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key used by the Codex CLI and raw executor OpenAI models
OPENAI_API_KEY=sk-...

# ===========================================================================
#  REQUIRED — Backend config (copy from your main .env)
# ===========================================================================

ENVIRONMENT=staging
# POSTGRES_USER=...
# POSTGRES_PASSWORD=...
# POSTGRES_HOST=...
# POSTGRES_HOST_NON_POOLING=...
# POSTGRES_DATABASE=...
# POSTGRES_USER_READ_REPLICA=...
# POSTGRES_PASSWORD_READ_REPLICA=...
# POSTGRES_HOST_READ_REPLICA=...
# POSTGRES_HOST_NON_POOLING_READ_REPLICA=...
# POSTGRES_DATABASE_READ_REPLICA=...

# ===========================================================================
#  OPTIONAL — Slack / Gateway
# ===========================================================================

# Base URL of the main backend (for gateway reply callbacks).
# Without this, agents still run — replies just aren't pushed to Slack.
# GATEWAY_BASE_URL=https://mind-staging.yupp.ai

# ===========================================================================
#  OPTIONAL — Filesystem paths (defaults match standard VM layout)
# ===========================================================================

# AHS_DATA_DIR=/data
# AHS_AGENTS_DIR=/data/agents
# AHS_SHARED_DIR=/data/shared
# AHS_REPOS_DIR=/data/repos
# AHS_SESSIONS_DIR=/data/sessions

# ===========================================================================
#  OPTIONAL — MCP tools
# ===========================================================================

# Token for the external yuppster-mcp-server (DB, logs, Slack tools).
# Referenced as ${YUPPSTER_MCP_TOKEN} in .mcp.json — Claude CLI expands it.
YUPPSTER_MCP_TOKEN=changeme

# Base URL of the AHS HTTP server (used to build the harness MCP endpoint URL).
# Only change if running on a non-default port.
# AHS_MCP_BASE_URL=http://127.0.0.1:8090

# ===========================================================================
#  OPTIONAL — Server & debugging
# ===========================================================================

# AHS_PORT=8090
# GCP_PROJECT_ID=yupp-llms
# AGENT_RESPONSE_DEBUG=true

# ===========================================================================
#  OPTIONAL — GitHub authentication (pick one approach)
# ===========================================================================

# Option A: GitHub App (recommended for production, see DEPLOYMENT.md)
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=78901234
# GITHUB_APP_PRIVATE_KEY_PATH=/data/ahs/github-app-key.pem

# Option B: Personal access token (simpler, for staging)
# GITHUB_TOKEN=github_pat_...
