[Unit]
Description=Artifact Viewer (read-only web UI for AHS artifacts)
After=network.target ahs-mono.service
Requires=network.target

[Service]
Type=simple
User=ahs
Group=ahs
# Installed as part of the monolith tree by install.sh. The sub-app has its
# own venv at apps/artifact-viewer/.venv (kept out of the main poetry env so
# Starlette/authlib/etc. don't leak into the monolith's dependency graph).
WorkingDirectory=/opt/yupp-agent/apps/artifact-viewer
# Reads the same .env as ahs-mono; viewer-specific vars are prefixed VIEWER_.
EnvironmentFile=/data/ahs/.env
ExecStart=/opt/yupp-agent/apps/artifact-viewer/.venv/bin/artifact-viewer
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
