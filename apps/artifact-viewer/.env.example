# Artifact Viewer — environment configuration.
#
# On the monolith VM the viewer reads the same /opt/yupp-agent/.env
# the AHS monolith uses; append these entries there. For local dev,
# copy this file to ``apps/artifact-viewer/.env`` and fill it in.
#
# Viewer-specific vars are prefixed with VIEWER_ to avoid colliding
# with AHS / MCP vars in the shared .env.

# --- Upstream AHS ---
# URL the viewer uses to reach AHS (defaults to public hostname).
VIEWER_AHS_BASE_URL=https://ahs.agcouch.com

# Shared secret — same value AHS uses. The viewer reads the existing
# AGENT_HARNESS_SERVICE_API_KEY from /opt/yupp-agent/.env on the VM,
# so you only need to set this explicitly for standalone dev.
# AGENT_HARNESS_SERVICE_API_KEY=

# --- Google OAuth (viewer-only) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match VIEWER_OAUTH_REDIRECT_URL below.
VIEWER_GOOGLE_CLIENT_ID=
VIEWER_GOOGLE_CLIENT_SECRET=
VIEWER_OAUTH_REDIRECT_URL=https://artifacts.agcouch.com/auth/callback

# --- Access control (viewer-only) ---
# Comma-separated email domains allowed to sign in (no @ prefix).
VIEWER_ALLOWED_EMAIL_DOMAINS=agcouch.com
# Optional extra individual emails (comma-separated). Takes precedence over domains.
VIEWER_ALLOWED_EMAILS=

# --- Server ---
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8095
# 32+ random bytes; rotate to invalidate all sessions.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VIEWER_SESSION_SECRET_KEY=change-me-in-prod
VIEWER_SESSION_MAX_AGE=1209600
# Keep true in prod (HTTPS only). Set false for local HTTP dev.
VIEWER_SESSION_COOKIE_SECURE=true
