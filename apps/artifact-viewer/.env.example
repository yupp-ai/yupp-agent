# Artifact Viewer — environment configuration.
# Copy to .env (or /opt/artifact-viewer/.env on the VM) and fill in.

# --- Upstream AHS ---
AHS_BASE_URL=https://ahs.agcouch.com
AHS_API_KEY=

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match OAUTH_REDIRECT_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://artifacts.agcouch.com/auth/callback

# --- Access control ---
# Comma-separated email domains allowed to sign in (no @ prefix).
ALLOWED_EMAIL_DOMAINS=agcouch.com
# Optional extra individual emails (comma-separated). Takes precedence over domains.
ALLOWED_EMAILS=

# --- Server ---
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8095
# 32+ random bytes; rotate to invalidate all sessions.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-in-prod
SESSION_MAX_AGE=1209600
# Keep true in prod (HTTPS only). Set false for local HTTP dev.
SESSION_COOKIE_SECURE=true
