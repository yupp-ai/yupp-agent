# Copy to .env.local and fill in.

# AHS — Agent Harness Service.
# For local dev, start AHS first: ./ypl/agent_harness_service/entrypoint.sh (port 8090).
# For staging: https://ahs-staging.yupp.ai
# For production: https://ahs.yupp.ai
AHS_HOST=http://localhost:8090
AHS_API_KEY=

# Slack Agent Gateway — only needed if you want the Slack pages to work.
SLACK_AGENT_GATEWAY_HOST=
SLACK_AGENT_GATEWAY_API_KEY=

# Google OAuth for War Room login.
# Create an OAuth client in GCP console, set authorized redirect URI to
# ${OAUTH_REDIRECT_HOST}/api/authentication/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_HOST=http://localhost:3009

# Any random 32+ char secret used to sign session cookies.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=
