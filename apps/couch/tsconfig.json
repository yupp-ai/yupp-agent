{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "./node_modules/.bun/node_modules/@types"],
    "types": ["bun"],
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@yupp/agents-runtime/*": ["./node_modules/@yupp/agents-runtime/src/*"],
      "@yupp/agents-ui/*": ["./node_modules/@yupp/agents-ui/src/*"],
      "@yupp/agents-protocol/*": ["./node_modules/@yupp/agents-protocol/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
