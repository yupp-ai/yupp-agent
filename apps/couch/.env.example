# AHS endpoint — local dev: http://localhost:8090 with ~/scripts/ahs-tunnel.sh running
AHS_HOST=http://localhost:8090
AHS_API_KEY=

# Auth — reuse war-room's local Google OAuth credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3010/api/authentication/google/callback
SESSION_SECRET=
SESSION_COOKIE_NAME=couch_session

# Allowed Google domains — keep in sync with war-room
ALLOWED_EMAIL_DOMAIN=yupp.ai
