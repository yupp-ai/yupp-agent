[Unit]
Description=AHS Streamlit — operational dashboards for the monolith
Documentation=https://github.com/yupp-ai/yupp-agent/blob/main/DEPLOYMENT.md
After=network-online.target ahs-mono.service
Wants=network-online.target
# Streamlit is non-critical — don't take down AHS if it fails.
PartOf=ahs-mono.service

[Service]
Type=simple
User=ahs
Group=ahs
WorkingDirectory=/opt/yupp-agent

EnvironmentFile=/opt/yupp-agent/.env
Environment=SERVICE_NAME_FOR_LOGGING=ahs-streamlit
Environment=PORT=8501
Environment=USE_GOOGLE_CLOUD_LOGGING=false
Environment=DISABLE_WRITE_GOOGLE_CLOUD_METRICS=true
Environment=PYTHONPATH=/opt/yupp-agent
Environment=PYTHONUNBUFFERED=1
# Mirror ahs-mono's HOME / AHS_DATA_DIR / PATH so Streamlit reads the same
# per-session state directories that AHS writes.
Environment=HOME=/data/ahs
Environment=AHS_DATA_DIR=/data/ahs
Environment=PATH=/data/ahs/.local/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/opt/yupp-agent/ypl/streamlit_server/selfhosted_entrypoint.sh

TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=3

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/data/ahs /tmp /var/log/ahs-mono

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ahs-streamlit

[Install]
WantedBy=multi-user.target
