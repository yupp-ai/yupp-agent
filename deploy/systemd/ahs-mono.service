[Unit]
Description=AHS Monolith — AHS + MCP + Slack/GitHub gateways
Documentation=https://github.com/yupp-ai/yupp-agent/blob/main/DEPLOYMENT.md
After=network-online.target postgresql.service redis.service
Wants=network-online.target
# Start streamlit only after this unit is healthy
Before=ahs-streamlit.service

[Service]
Type=simple
User=ahs
Group=ahs
WorkingDirectory=/opt/yupp-agent

# .env file holds all secrets — chmod 600, owned by the ahs user.
EnvironmentFile=/opt/yupp-agent/.env
Environment=SERVICE_NAME_FOR_LOGGING=ahs-mono
Environment=AHS_PORT=8090
Environment=USE_GOOGLE_CLOUD_LOGGING=false
Environment=DISABLE_WRITE_GOOGLE_CLOUD_METRICS=true
Environment=PYTHONPATH=/opt/yupp-agent
Environment=PYTHONUNBUFFERED=1
# HOME must match the ahs user's useradd --home-dir so tools like claude /
# codex / git / ssh find their state where they expect it. AHS_DATA_DIR is
# explicit (rather than letting common/constants.py auto-default to /data)
# so the monolith layout is documented in the unit file itself.
Environment=HOME=/data/ahs
Environment=AHS_DATA_DIR=/data/ahs
# PATH: /data/ahs/.local/bin for `claude`; /usr/local/bin for `codex` + `poetry`.
Environment=PATH=/data/ahs/.local/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/opt/yupp-agent/.venv/bin/uvicorn \
    ypl.mono_server.server:app \
    --host 0.0.0.0 \
    --port ${AHS_PORT} \
    --loop uvloop \
    --log-config ypl/uvicorn-logging.yml

# Graceful shutdown: give in-flight agent tasks 30 s to complete
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# Only grant write access to subdirs actually written by the app at runtime.
# Keeping /opt/yupp-agent itself read-only prevents a compromised process from
# modifying source files that get loaded on the next restart.
# All runtime-writable state lives under /data/ahs:
#   sessions/ repos/ memories/ tool-results/ .cache/ .claude/ .codex/ etc.
# Plus /tmp (scratch) and /var/log/ahs-mono (journal spillover if any).
ReadWritePaths=/data/ahs /tmp /var/log/ahs-mono

# Logging — journald captures stdout/stderr automatically
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ahs-mono

[Install]
WantedBy=multi-user.target
