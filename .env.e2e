# E2E testing configuration
# Used by: ./scripts/run_local.sh --e2e
# These values override .env when running in e2e mode.

ENVIRONMENT=local
DEFAULT_DB=agentdb

# Known test API key (must match what e2e tests send)
AGENT_HARNESS_SERVICE_API_KEY=e2e-test-api-key
X_API_KEY=e2e-test-api-key

# Slack capture mode — intercepts outbound Slack API calls
SLACK_CAPTURE_MODE=true

# Test bot configuration
SLACK_AGENT_GATEWAY_AGENTS=e2e_test_bot
SLACK_AGENT_GATEWAY_E2E_TEST_BOT_APP_ID=A_E2E_TEST
SLACK_AGENT_GATEWAY_E2E_TEST_BOT_BOT_TOKEN=xoxb-fake-e2e-token
SLACK_AGENT_GATEWAY_E2E_TEST_BOT_SIGNING_SECRET=e2e-test-signing-secret
SLACK_AGENT_GATEWAY_E2E_TEST_BOT_DISPLAY_NAME="E2E Test Bot"
SLACK_AGENT_GATEWAY_E2E_TEST_BOT_AGENT_NAME=parrot-bubba

# Service URLs — monolith serves everything on one port
AGENT_HARNESS_SERVICE_BASE_URL=http://localhost:8090
GATEWAY_BASE_URL=http://localhost:8090
MCP_SERVER_BASE_URL=http://localhost:8090

# Disable cloud services
USE_GOOGLE_CLOUD_LOGGING=false
DISABLE_WRITE_GOOGLE_CLOUD_METRICS=true
SANDBOX_ENABLED=false
