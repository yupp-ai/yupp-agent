ENVIRONMENT=local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost:5432
POSTGRES_DATABASE=yupp_agent

# --- Identity / email gating -------------------------------------------------
# JSON list of email domains allowed to resolve to a user / create personal
# agents. Empty = no gating (all domains pass).
ALLOWED_EMAIL_DOMAINS=["example.com"]
# Same, scoped to MCP token issuance. Leave empty to piggy-back on
# ALLOWED_EMAIL_DOMAINS-style deployments or restrict independently.
ALLOWED_MCP_EMAIL_DOMAINS=["example.com"]

# --- System / service account emails -----------------------------------------
# Addresses used for internal "robot" accounts. Required when running
# `python -m ypl.mono_server.setup` (creates the row) or when the GitHub
# webhook fires (looks it up to attribute webhook-triggered sessions).
SYSTEM_USER_EMAIL=system@example.com
SYSTEM_GITHUB_WEBHOOK_USER_EMAIL=system-github-webhook@example.com
# Synthetic domain used for programmatic agent User rows. Keep distinct from
# ALLOWED_EMAIL_DOMAINS so agent identities stay out of human employee flows.
AGENT_USER_EMAIL_DOMAIN=agents.example.com

# --- External UI base URLs (used in Slack / Streamlit link generation) ------
# Each is optional — when empty, the corresponding link is omitted from
# generated messages.
AHS_LIT_BASE_URL=
AHS_WAR_ROOM_BASE_URL=

# --- Slack Agent Gateway public URL -----------------------------------------
# Required when BotFather creates Slack apps — the manifest's request_url /
# OAuth redirect_uri are built from this. Format: scheme + host, no path.
GATEWAY_BASE_URL=

# --- AHS CORS ---------------------------------------------------------------
# Loopback ports for local dev are always allowed. Add production frontends
# as a JSON list and/or a wildcard regex.
AHS_CORS_ALLOW_ORIGINS=[]
AHS_CORS_ALLOW_ORIGIN_REGEX=

# --- Outgoing email senders (Resend) -----------------------------------------
# "Display Name <local@domain.tld>". Required only if email sending is enabled.
TEAM_FROM_EMAIL_ADDRESS="Team <team@updates.example.com>"
SUPPORT_FROM_EMAIL_ADDRESS="Support <support@updates.example.com>"
NOTICE_FROM_EMAIL_ADDRESS="Notice <notice@updates.example.com>"
ONBOARDING_FROM_EMAIL_ADDRESS="Onboarding <onboarding@updates.example.com>"
PAYMENTS_FROM_EMAIL_ADDRESS="Payments <payments@updates.example.com>"
