ENVIRONMENT=local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost:5432
POSTGRES_DATABASE=yupp_agent

# --- Identity / email gating -------------------------------------------------
# JSON list of email domains allowed to resolve to a user / create personal
# agents. Empty = no gating (all domains pass).
ALLOWED_EMAIL_DOMAINS=["example.com"]
# Same, scoped to MCP token issuance. Leave empty to piggy-back on
# ALLOWED_EMAIL_DOMAINS-style deployments or restrict independently.
ALLOWED_MCP_EMAIL_DOMAINS=["example.com"]

# --- System / service account emails -----------------------------------------
# Addresses used for internal "robot" accounts. Required when running
# `python -m ypl.mono_server.setup` (creates the row) or when the GitHub
# webhook fires (looks it up to attribute webhook-triggered sessions).
SYSTEM_USER_EMAIL=system@example.com
SYSTEM_GITHUB_WEBHOOK_USER_EMAIL=system-github-webhook@example.com
# Synthetic domain used for programmatic agent User rows. Keep distinct from
# ALLOWED_EMAIL_DOMAINS so agent identities stay out of human employee flows.
AGENT_USER_EMAIL_DOMAIN=agents.example.com

# --- External UI base URLs (used in Slack / Streamlit link generation) ------
# Each is optional — when empty, the corresponding link is omitted from
# generated messages.
AHS_LIT_BASE_URL=

# Slack workspace subdomain — used to build Slack permalinks back to threads
# from Lit (e.g. project-management task views). Just the subdomain, no scheme
# or path: ``yuppai`` → ``https://yuppai.slack.com/archives/...``. When empty,
# the Slack jump-link column is omitted from task views.
SLACK_WORKSPACE_DOMAIN_NAME=

# --- Slack Agent Gateway public URL -----------------------------------------
# Required when BotFather creates Slack apps — the manifest's request_url /
# OAuth redirect_uri are built from this. Format: scheme + host, no path.
GATEWAY_BASE_URL=

# --- AHS CORS ---------------------------------------------------------------
# Loopback ports for local dev are always allowed. Add production frontends
# as a JSON list and/or a wildcard regex.
AHS_CORS_ALLOW_ORIGINS=[]
AHS_CORS_ALLOW_ORIGIN_REGEX=

# --- Mono server master feature flags ---------------------------------------
# Both default to FALSE so the monolith boots as a pure AHS process. Existing
# operators that relied on Slack/GitHub gateways or the agcouch MCP mount
# being on must explicitly opt in. See DEPLOYMENT.md for the deployment
# shapes that need each flag.
#
# AHS_MONO_ENABLE_GATEWAY_SERVICE  Master flag for /gw/<name>/ plugin mounts.
#                                  Default: false. When false, the per-plugin
#                                  GATEWAY_*_ENABLED sub-flags below are
#                                  ignored.
# AHS_MONO_ENABLE_MCP              Master flag for the /mcp/agcouch mount and
#                                  the agcouch FastMCP lifespan. Default:
#                                  false. /mcp/harness is always mounted —
#                                  AHS sessions always have a tool surface.
AHS_MONO_ENABLE_GATEWAY_SERVICE=false
AHS_MONO_ENABLE_MCP=false

# --- Per-plugin gateway sub-flags (only consulted when ----------------------
#     AHS_MONO_ENABLE_GATEWAY_SERVICE=true)
# GATEWAY_SLACK_ENABLED             Mount /gw/slack. Default: true.
# GATEWAY_GITHUB_ENABLED            Mount /gw/github. Default: false. Requires
#                                   AHS_GITHUB_WEBHOOK_SECRET to be set.
GATEWAY_SLACK_ENABLED=true
GATEWAY_GITHUB_ENABLED=false

# --- Project task executor --------------------------------------------------
# Fallback agent (by ``Agent.name``) used when a project task has no
# task-level ``agent_id`` AND its project has no ``default_agent_id``.  Lets
# operators stand up new projects without wiring a default agent on every
# one.  Empty = no fallback (tasks without an agent will fail as before).
PROJECT_DEFAULT_AGENT=
